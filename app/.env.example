# Repository the demo runs against
GITHUB_REPOSITORY=Slaybol/release-tool

# Secret set on the GitHub webhook (or GitHub App webhook)
WEBHOOK_SECRET=

# GitHub App (preferred)
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Private key with newlines written as \n
GITHUB_PRIVATE_KEY=

# Or a fine-grained token with Contents read/write, Actions read, Deployments read
GITHUB_TOKEN=

# Optional
PORT=3000
PRODUCT_NAME=Web app
BUILD_WORKFLOW=Build
TEST_ENVIRONMENTS=qa,staging
RELEASE_OWNERS=Slaybol
DATA_DIR=data
SOAK_ENVIRONMENT=staging
# When set, shipping, note edits and matrix uploads need "Authorization: Bearer <token>"
ADMIN_TOKEN=

# Test matrix workbook imported once on start (sheets "Test Matrix" and "Configurations")
MATRIX_FILE=
POLL_SECONDS=60

# Readiness gates
TEST_TARGET_PCT=90
ERROR_THRESHOLD=8
# Hours the candidate must spend in SOAK_ENVIRONMENT. Use 0.25 for a live demo.
SOAK_HOURS=24
# Other repos that must have a published tag first, e.g. [{"name":"API","repo":"Slaybol/api","tag":"v2.3.0"}]
DEPENDENCIES=

# Jira (WEB project, bugs linked by fix version). Leave blank for simulated demo data.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=WEB
# {line} becomes the release line, e.g. 4.12
JIRA_FIX_VERSION={line}

# Zephyr Scale. Test cycles whose name holds the version or build id; execution environment = matrix configuration.
ZEPHYR_API_TOKEN=
ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2
ZEPHYR_PROJECT=WEB

# Elastic (RUM sessions and errors by service.version). Leave blank for simulated demo data.
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_SERVICE=web-app
ELASTIC_RUM_INDEX=traces-apm.rum*
ELASTIC_ERROR_INDEX=logs-apm.error*
# Length of the simulated demo story (rc.1 goes wrong, rc.2 comes good)
DEMO_MINUTES=20
